# Cashew Selfhosted -- settings for the deployment compose file. Copy to .env, edit as needed, then `docker compose up -d`.
# No secrets here -- accounts are created in the app on first run.

# Which published version to run; `latest` moves to each new release on the next pull. See https://github.com/vfyuj/cashew-selfhosted/releases.
CASHEW_VERSION=latest

# Host port -- the container itself always listens on 8080.
CASHEW_PORT=8080

# Where the database, backups and attachments live on the host.
CASHEW_DATA_DIR=./data

# IANA timezone name, e.g. Europe/Berlin.
TZ=UTC

# Set to false to silence per-request logging.
LOG_REQUESTS=true

# Only set true behind a reverse proxy you control; leave false if this port is reachable directly.
TRUST_PROXY_HEADER=false
