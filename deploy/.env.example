# Cashew Selfhosted -- settings for the deployment compose file.
#
# Copy this to .env in the same folder, then edit if you want to change
# something:
#
#   cp .env.example .env
#
# Every setting here already has a working default, so you can start with an
# unedited copy and come back to it later. Apply any change with:
#
#   docker compose up -d
#
# Note .env holds settings, not secrets -- there are no API keys or passwords in
# a Cashew Selfhosted deployment. Accounts are created in the app on first run.


# Which published version to run.
#
# `latest` moves to each new release the next time you pull. Pin an exact
# version instead if you'd rather decide when to move -- for example:
#
#   CASHEW_VERSION=1.0.0
#
# Published versions: https://github.com/vfyuj/cashew-selfhosted/releases
CASHEW_VERSION=latest


# Port on the host, i.e. the one you put in the browser.
#
# Change this if something else already uses 8080; the server inside the
# container always listens on 8080 regardless.
CASHEW_PORT=8080


# Where the data lives on the host: the SQLite database, backups and
# attachments.
#
# Relative paths are resolved from this folder, so the default keeps everything
# in ./data next to the compose file. An absolute path works too if you want the
# data on a different disk -- for example /mnt/storage/cashew.
CASHEW_DATA_DIR=./data


# Timezone for the container, used for log timestamps and for anything the
# server schedules by local time. Any tz database name, e.g. Europe/Berlin.
TZ=UTC


# Per-request logging. Set to false to silence it entirely.
#
# Left on because you are more likely to need the log than the disk space; the
# 30 MB cap in the compose file is what keeps it affordable.
LOG_REQUESTS=true


# Whether to trust the X-Forwarded-For header to identify clients for auth rate
# limiting.
#
# Leave this false whenever the container's port is reachable directly, which is
# what this template sets up by default: the header is set by the client, so
# trusting it lets anyone dodge the rate limit on password attempts by forging a
# new address each try.
#
# Set it to true only when a reverse proxy you control (Nginx Proxy Manager,
# Caddy, Traefik) sits in front and the container port is not exposed to the
# network directly. Behind a proxy the opposite problem applies: without this,
# every request appears to come from the proxy, so one person hitting the rate
# limit locks out everyone.
TRUST_PROXY_HEADER=false
