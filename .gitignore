# Reference-only clone of upstream Cashew, kept local for diffing/porting.
# Not part of this fork's source -- see CLAUDE.md.
/upstream/

.DS_Store

# Personal Claude Code permission grants, not shared config.
.claude/settings.local.json

# Local test databases created by the runbook in TESTING.md.
/.testdata*/

# Running deploy/docker-compose.yml from inside a clone puts a live instance
# here: its database in data/, its settings in .env. The tracked template is
# .env.example, not .env.
/deploy/data/
/deploy/.env
